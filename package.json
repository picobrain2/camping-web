{
  "name": "camping-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "sync": "node scripts/sync-gocamping.mjs",
    "sync:all": "node scripts/sync-gocamping.mjs --all",
    "sync:photos": "node scripts/sync-photos.mjs",
    "enrich:homepages": "node scripts/enrich-homepages.mjs",
    "catalog:upload": "node scripts/upload-catalog-firestore.mjs",
    "deploy": "npm run build && npx firebase-tools@13 deploy --only hosting,firestore:rules --project camping-cf64d",
    "deploy:hosting": "npm run build && npx firebase-tools@13 deploy --only hosting --project camping-cf64d",
    "deploy:rules": "npx firebase-tools@13 deploy --only firestore:rules --project camping-cf64d"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "firebase": "^11.10.0"
  }
}
